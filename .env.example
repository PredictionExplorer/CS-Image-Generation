# CosmicSignature asset sync configuration
# Copy this file to .env and fill in your deployment values.
# .env is excluded from version control via .gitignore.

# Remote server to upload generated assets to
COSMICSIG_SSH_HOST=your.server.com
COSMICSIG_SSH_USER=frontend

# CosmicGame API base URL (no trailing slash)
COSMICSIG_API_URL=http://your-api-host:8353

# Arbitrum seed fallback/verification source
# Public RPC is used by default if omitted; set your own provider URL for reliability.
COSMICSIG_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
COSMICSIG_NFT_CONTRACT=0xbb84Be3500A63581d3F2d5AC3bdF8685AAedad25

# Remote directory where PNG/MP4 assets are stored
COSMICSIG_REMOTE_DIR=/home/frontend/nft-assets/new/cosmicsignature

# Optional: packages missing only the ember edition (or holding one of an older look) to
# regenerate per run, after every new or incomplete package (default 1; 0 pauses the backfill)
# COSMICSIG_MAX_BACKFILL=1

# Optional: how a backfilled package is uploaded (default ember).
#   ember  upload only its ember edition and a merged metadata/assets.json, after checking that
#          the render shows the same orbit in the same view as the live package (never touches
#          the main art)
#   full   replace the whole remote package, main art included
# COSMICSIG_BACKFILL_MODE=ember

# Optional: failed ember attempts after which a backfill seed is given up until the generator
# binary changes (default 3). Other failures never give a seed up: they only move it behind the
# seeds that have failed less often.
# COSMICSIG_MAX_BACKFILL_ATTEMPTS=3

# Optional: what a run does with live ember editions of an older ember algorithm, after a deploy
# that changes the look (default no). Set it before that deploy. Either way the backfill renders
# each of them again in the current look, COSMICSIG_MAX_BACKFILL per run.
#   no   withdraw them all at once: a token has no ember edition until its turn in the backfill,
#        so the old look is never online next to the new one
#   yes  withdraw nothing: each stays online until the backfill replaces it in place, so no token
#        is without an ember edition, and both looks are online meanwhile. It does not keep the
#        old editions for good: add COSMICSIG_MAX_BACKFILL=0 to hold every live edition as it is.
# COSMICSIG_KEEP_STALE_EMBER=no
